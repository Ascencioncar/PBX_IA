# Copia este archivo a .env y rellena los valores.  NO commitear .env.

# --- LLM (Ollama) --- por HTTP, NO asumir localhost en producción
OLLAMA_HOST=http://127.0.0.1:11434
MODEL=qwen3:8b
MODEL_SMOKE=llama3.2:3b
NUM_CTX=8192
LLM_THINK=false        # qwen3: apagar reasoning (clave para latencia de voz)
NUM_PREDICT=200        # tope de tokens de respuesta
OLLAMA_KEEP_ALIVE=30m  # mantener el modelo en memoria (evita recarga de ~60s tras inactividad)

# --- STT (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu             # cpu | cuda (cuda pelea VRAM con el LLM)
WHISPER_COMPUTE=int8           # int8 (cpu) | int8_float16 (cuda)

# --- TTS (Kokoro-82M, CPU) ---
TTS_LANG=e                     # 'e' = español
TTS_VOICE=ef_dora              # ef_dora / em_alex / em_santa ...
TTS_SPEED=1.0

# --- Herramientas del usuario (APIs/webhooks) ---
# Si TOOLS_BASE_URL queda vacío, dispatch() devuelve respuestas SIMULADAS
# para no bloquear las pruebas de tool calling.
TOOLS_BASE_URL=
TOOLS_API_KEY=
TOOLS_TIMEOUT=10

# --- Telefonía (Fase 3) ---
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9000

# --- Voz: streaming y barge-in (MejorPBX A1/A2) ---
VOICE_STREAMING=true           # TTS por frases (menor time-to-first-audio)
BARGE_IN=false                 # permitir interrumpir al agente hablando (experimental)

# --- Historial / topes de llamada (A3/A5) ---
HISTORY_MAX_TURNS=8            # turnos de usuario conservados (ventana deslizante)
MAX_UTTERANCE_MS=15000        # duración máxima de un turno
MAX_CALL_SECONDS=600          # duración máxima de la llamada

# --- Observabilidad (A6) ---
LOG_LEVEL=INFO
LOG_JSON=false                 # true = logs en JSON
CALL_LOG_DIR=                  # carpeta para transcripciones (vacío = desactivado)

# --- Seguridad del dispatch de herramientas (A8, anti-SSRF) ---
# Lista blanca de hosts (coma-separada). Vacío = sin restricción.
TOOLS_ALLOWED_HOSTS=
TOOLS_ALLOW_PRIVATE=false       # con allowlist activa, permite IPs privadas (LAN / host.docker.internal)

# --- Webui: autenticación (B1) ---
WEBUI_USER=admin
# Genera el hash con:  python -c "import bcrypt;print(bcrypt.hashpw(b'TU_CLAVE',bcrypt.gensalt()).decode())"
WEBUI_PASSWORD_HASH=
# Solo laboratorio (si no pones hash). NO usar en producción:
WEBUI_PASSWORD=
WEBUI_SECRET=                   # secreto para firmar la cookie (vacío = derivado del hash)
WEBUI_SESSION_HOURS=12
