# Servicio de voz (Fase 2): STT faster-whisper + TTS Kokoro, ambos en CPU.
FROM python:3.12-slim

# espeak-ng: G2P que usa Kokoro para español.  libsndfile1: para soundfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak-ng \
        libsndfile1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencias fijadas desde una sola fuente (MejorPBX A7); torch CPU incluido
# (requirements-voice.txt trae el --extra-index-url del índice CPU de PyTorch).
COPY requirements-core.txt requirements-voice.txt ./
RUN pip install --no-cache-dir -r requirements-voice.txt

COPY . .

# Hardening (A7): usuario no-root. La caché de modelos (HF) vive en su home
# (el volumen hf_cache se monta ahí en docker-compose).
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /home/appuser/.cache \
    && chown -R appuser /home/appuser /app
ENV HF_HOME=/home/appuser/.cache/huggingface \
    XDG_CACHE_HOME=/home/appuser/.cache
USER appuser

CMD ["python", "-m", "agent.voice_pipeline", "--selftest"]
