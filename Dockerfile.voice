# Servicio de voz (Fase 2): STT faster-whisper + TTS Kokoro, ambos en CPU.
FROM python:3.12-slim

# espeak-ng: G2P que usa Kokoro para español.  libsndfile1: para soundfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak-ng \
        libsndfile1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch CPU primero (evita arrastrar las ruedas CUDA, que pesan GBs).
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    "ollama>=0.4.0" \
    "openai>=1.40" \
    "httpx>=0.27" \
    "python-dotenv>=1.0" \
    "faster-whisper>=1.0" \
    "kokoro>=0.9" \
    "soundfile>=0.12" \
    "soxr>=0.5" \
    "numpy>=1.26" \
    "webrtcvad-wheels>=2.0"

COPY . .

CMD ["python", "-m", "agent.voice_pipeline", "--selftest"]
