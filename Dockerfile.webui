# Interfaz web: compila React (Node) y lo sirve desde FastAPI (un solo contenedor).

# --- Stage 1: build del frontend React ---
FROM node:20-alpine AS build
WORKDIR /build
COPY webui/frontend/package.json ./
RUN npm install
COPY webui/frontend/ ./
RUN npm run build          # genera /build/dist

# --- Stage 2: backend FastAPI + estáticos ---
FROM python:3.12-slim
WORKDIR /app

# Dependencias fijadas desde una sola fuente (MejorPBX A7).
COPY requirements-core.txt requirements-webui.txt ./
RUN pip install --no-cache-dir -r requirements-webui.txt

COPY --from=build /build/dist /opt/webui/dist
ENV WEBUI_DIST=/opt/webui/dist
# El código se monta por volumen en compose; este COPY es respaldo autónomo.
COPY . /app

# Hardening (A7): usuario no-root.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app /opt/webui
USER appuser

CMD ["uvicorn", "webui.app:app", "--host", "0.0.0.0", "--port", "8000"]
